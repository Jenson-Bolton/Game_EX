{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs2022",
      "displayName": "Visual Studio 2022 x64",
      "description": "Configure the complete Game_EX workspace for 64-bit Windows.",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs2022",
      "cacheVariables": {
        "GAMEEX_BUILD_DOCUMENTATION": "ON",
        "GAMEEX_ENABLE_GUI_SMOKE_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Build Debug",
      "configurePreset": "vs2022",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "displayName": "Build Release",
      "configurePreset": "vs2022",
      "configuration": "Release"
    },
    {
      "name": "docs",
      "displayName": "Build API documentation",
      "configurePreset": "vs2022",
      "configuration": "Debug",
      "targets": [
        "docs"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "displayName": "Run Debug tests",
      "configurePreset": "vs2022",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
