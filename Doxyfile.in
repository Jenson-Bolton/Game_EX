PROJECT_NAME           = "Game_EX"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "Large-world transport, city, and land-use simulation"

OUTPUT_DIRECTORY       = "@CMAKE_BINARY_DIR@/docs/doxygen"
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
OUTPUT_LANGUAGE        = English

INPUT                  = "@CMAKE_SOURCE_DIR@/Engine/include" \
                         "@CMAKE_SOURCE_DIR@/Engine/src" \
                         "@CMAKE_SOURCE_DIR@/WorldCompiler/include" \
                         "@CMAKE_SOURCE_DIR@/WorldCompiler/src" \
                         "@CMAKE_SOURCE_DIR@/WorldCompiler/tools" \
                         "@CMAKE_SOURCE_DIR@/WorldCompiler/tests" \
                         "@CMAKE_SOURCE_DIR@/Game/include" \
                         "@CMAKE_SOURCE_DIR@/Game/src" \
                         "@CMAKE_SOURCE_DIR@/docs/doxygen"
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.hpp *.cpp *.dox
EXCLUDE_PATTERNS       = */build/* */_deps/*
STRIP_FROM_PATH        = "@CMAKE_SOURCE_DIR@"

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = NO

HAVE_DOT               = NO
QUIET                   = YES
